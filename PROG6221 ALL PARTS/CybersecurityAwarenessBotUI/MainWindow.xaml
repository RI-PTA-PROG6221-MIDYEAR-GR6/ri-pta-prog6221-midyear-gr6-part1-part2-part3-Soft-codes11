<Window x:Class="CybersecurityAwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CybersecurityAwarenessBot.Models"
        Title="Cybersecurity Awareness Bot"
        Width="1040" Height="740" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- One chat bubble. Bot bubbles sit left, user bubbles sit right. -->
        <DataTemplate DataType="{x:Type models:ChatMessage}">
            <Border x:Name="Bubble"
                    Margin="0,6" Padding="14,10" MaxWidth="560"
                    CornerRadius="14"
                    HorizontalAlignment="Left"
                    Background="{StaticResource BotBubbleBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                               LineHeight="21" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Time}" FontSize="10" HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBot}" Value="False">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource UserBubbleBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style x:Key="ScrollBarRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="{Binding IsDirectionReversed, RelativeSource={RelativeSource TemplatedParent}}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource ScrollBarRepeatButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource ScrollBarRepeatButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopicButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ContrastToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource UserBubbleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <SolidColorBrush x:Key="QuickTopicsSectionBrush" Color="#15505A"/>
        <SolidColorBrush x:Key="MemorySectionBrush" Color="#27365B"/>
        <SolidColorBrush x:Key="TasksSectionBrush" Color="#493456"/>
        <SolidColorBrush x:Key="ToolsSectionBrush" Color="#1A4B4B"/>

        <Style x:Key="SidebarExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="{Binding RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Path=Background}"
                                CornerRadius="7" Padding="10,7">
                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Part 3 layout: the sidebar contains task and productivity tools,
         while the second column contains the chatbot conversation. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR =====================
             Demonstrate this area in the video: quick topics, memory,
             task/reminder management, quiz, activity log and clear-chat tools. -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact ASCII shield + title -->
                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="SidebarShield" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Cybersecurity Awareness Bot" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- Quick-topic buttons send predefined cybersecurity questions to ChatEngine. -->
                <Expander Grid.Row="1" Header="Quick topics" Style="{StaticResource SidebarExpander}"
                          Background="{StaticResource QuickTopicsSectionBrush}" IsExpanded="True">
                    <StackPanel Margin="0,4,0,0">
                    <Button Content="Password safety" Tag="Tell me about password safety" Style="{StaticResource TopicButton}" Click="TopicButton_Click"/>
                    <Button Content="Phishing and scams" Tag="Give me a phishing tip" Style="{StaticResource TopicButton}" Click="TopicButton_Click"/>
                    <Button Content="Privacy" Tag="Tell me about privacy" Style="{StaticResource TopicButton}" Click="TopicButton_Click"/>
                    <Button Content="Safe browsing" Tag="How do I browse safely?" Style="{StaticResource TopicButton}" Click="TopicButton_Click"/>
                    <Button Content="Malware" Tag="Tell me about malware" Style="{StaticResource TopicButton}" Click="TopicButton_Click"/>
                    <Button Content="Social engineering" Tag="What is social engineering?" Style="{StaticResource TopicButton}" Click="TopicButton_Click"/>
                    <Button Content="Account security" Tag="How do I secure my accounts?" Style="{StaticResource TopicButton}" Click="TopicButton_Click"/>
                    </StackPanel>
                </Expander>

                <!-- Memory and mood panel: updated when the chatbot learns about the user. -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Top" Margin="0,0,2,0">
                    <Expander Header="What I remember" Style="{StaticResource SidebarExpander}"
                              Background="{StaticResource MemorySectionBrush}" IsExpanded="True">
                        <Border Background="{StaticResource PanelLightBrush}" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock x:Name="MemoryText" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="Nothing yet. Tell me your interests!"/>
                                <TextBlock x:Name="MoodText" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0"
                                           Foreground="{StaticResource AccentBrush}" Text="Mood: not detected yet"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- Part 3 task assistant: create, view, complete and delete tasks. -->
                    <Expander Header="Task assistant" Style="{StaticResource SidebarExpander}"
                              Background="{StaticResource TasksSectionBrush}" IsExpanded="True">
                    <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="Title (required)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TaskTitleBox" Margin="0,0,0,5" Padding="7" FontSize="12"
                             Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}"
                             BorderThickness="0" ToolTip="Enter a short name for the cybersecurity task"
                             AutomationProperties.Name="Task title"/>
                    <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TaskDescriptionBox" Margin="0,0,0,5" Padding="7" FontSize="12"
                             Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}"
                             BorderThickness="0" ToolTip="Add details about the task, if needed"
                             AutomationProperties.Name="Task description"/>
                    <TextBlock Text="Reminder date (optional)" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="TaskReminderPicker" Margin="0,0,0,5" SelectedDateFormat="Short"
                                Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}"
                                ToolTip="Optional reminder date"/>
                    <TextBlock Text="Reminder time (required with a date, HH:mm)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TaskReminderTimeBox" Text="09:00" MaxLength="5" Margin="0,0,0,5" Padding="7" FontSize="12"
                             Background="{StaticResource PanelLightBrush}" Foreground="{StaticResource TextBrush}"
                             BorderThickness="0" ToolTip="Enter the reminder time using 24-hour format, for example 14:30"
                             AutomationProperties.Name="Reminder time"/>
                    <Button Content="Add task" Style="{StaticResource PrimaryButton}" Click="AddTaskButton_Click"/>
                    <Button Content="Clear tasks &amp; reminders" Style="{StaticResource ModernButton}"
                            Margin="0,4,0,0" Padding="8,6"
                            ToolTip="Permanently remove all tasks and reminders"
                            Click="ClearTasksButton_Click"/>
                    <ListBox x:Name="TaskList" Margin="0,8,0,0" MaxHeight="220"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CyberTask}">
                                <Border Background="{StaticResource PanelLightBrush}" CornerRadius="6" Padding="7" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ReminderText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Complete" Tag="complete" Padding="5,2" Margin="0,0,4,0" Click="TaskActionButton_Click"/>
                                            <Button Content="Delete" Tag="delete" Padding="5,2" Click="TaskActionButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>

                <!-- Part 3 tools: start the quiz, view the activity log and clear chat. -->
                <Expander Grid.Row="3" Header="Tools" Style="{StaticResource SidebarExpander}"
                          Background="{StaticResource ToolsSectionBrush}" IsExpanded="True"
                          Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                             <Button Grid.Column="0" Content="Quiz" Tag="Start quiz"
                                     Style="{StaticResource ContrastToolButton}" Margin="0,0,4,0"
                                    Click="TopicButton_Click"/>
                            <Button Grid.Column="1" Content="Activity log" Tag="Show activity log"
                                     Style="{StaticResource ContrastToolButton}" Margin="4,0,0,0"
                                    Click="TopicButton_Click"/>
                        </Grid>
                        <Button Content="Clear chat" Style="{StaticResource ContrastToolButton}"
                                HorizontalContentAlignment="Center" Margin="0,8,0,0"
                                Padding="8,6" Click="ClearButton_Click"/>
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <!-- ===================== CHAT AREA ===================== -->
        <Grid Grid.Column="1" Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat header: the hamburger button demonstrates the sidebar toggle. -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button x:Name="SidebarToggleButton" DockPanel.Dock="Left" Content="☰"
                        Style="{StaticResource ContrastToolButton}" Width="34" Height="30"
                        Padding="0" Margin="0,0,10,0" ToolTip="Open or close the sidebar"
                        Panel.ZIndex="1"
                        Click="SidebarToggleButton_Click"/>
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{StaticResource AccentBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Chat with CyberBot" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="VoiceStatus" DockPanel.Dock="Right" FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Text="Playing voice greeting..."/>
            </DockPanel>

            <!-- Conversation -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12">
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="18,12">
                    <ItemsControl x:Name="ChatList"/>
                </ScrollViewer>
            </Border>

            <!-- Typing indicator -->
            <TextBlock x:Name="TypingText" Grid.Row="2" Text="CyberBot is typing..." FontStyle="Italic"
                       FontSize="12" Margin="6,8,0,0" Visibility="Hidden"
                       Foreground="{StaticResource MutedBrush}"/>

            <!-- Input -->
            <Border Grid.Row="3" Margin="0,8,0,0" Background="{StaticResource PanelBrush}"
                    CornerRadius="12" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0" MaxLength="300" FontSize="14"
                             Background="Transparent" BorderThickness="0" CaretBrush="White"
                             Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center"
                             Padding="8,6" IsEnabled="False"
                             ToolTip="Type your question and press Enter"
                             KeyDown="InputBox_KeyDown"/>
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" Padding="26,9" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="SendButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== WELCOME / NAME ENTRY ===================== -->
        <Grid x:Name="WelcomeOverlay" Grid.ColumnSpan="2" Background="#F20B1220">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock x:Name="WelcomeLogo" FontFamily="Consolas" FontSize="14"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Welcome to the Cybersecurity Awareness Bot!" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,22,0,4"/>
                <TextBlock Text="I'm here to help you stay safe online. What should I call you?" FontSize="14"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <Border Background="{StaticResource PanelLightBrush}" CornerRadius="10" Padding="6" Width="340">
                    <TextBox x:Name="NameBox" MaxLength="30" FontSize="15" Background="Transparent"
                             BorderThickness="0" CaretBrush="White" Foreground="{StaticResource TextBrush}"
                             Padding="8,7" KeyDown="NameBox_KeyDown"/>
                </Border>

                <TextBlock x:Name="NameError" Foreground="{StaticResource ErrorBrush}" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <Button Content="Start chatting" Style="{StaticResource PrimaryButton}" Width="340"
                        Padding="0,11" Margin="0,14,0,0" Click="StartButton_Click"/>

                <TextBlock x:Name="WelcomeVoiceStatus" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
